CrmInternalNotes=Notes internes
CrmNotePlaceholder=Écrire une note interne (envoyée à personne)
CrmNoteFilesMax=Fichiers jusqu'à %s chacun
CrmAddNote=Ajouter la note
CrmNoteEdited=modifiée le %s par %s
