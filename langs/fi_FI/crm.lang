CrmLogStatusSimulated=Simuloitu
CrmLogStatusDraft=Luonnos
CrmLogStatusError=Virhe
CrmLogWhy=Askel %s, päivä %s
CrmLogWhyTitle=Syy (lähestymisen askel ja päivä)
